# publish-bundle 环境变量模板（stage-bundle 在部署服务器上无需任何配置）。
# 复制为 .env 后填入真实值（.env 已被 gitignore 模板忽略，请勿提交真实密钥）。
# publish-bundle 加载顺序：当前目录 .env -> 本脚本所在目录 .env；已有的进程环境变量优先。

# 远端部署服务器（SSH 连接账户）
SYNC_REMOTE_HOST=
SYNC_REMOTE_PORT=

# SSH 鉴权类型: password（默认）| sshkey
#   sshkey = 免密鉴权：先把本地公钥加入远端服务器 ~/.ssh/authorized_keys，
#   之后无需在 .env 存储任何密码（SYNC_REMOTE_PASSWORD 可留空）
SYNC_REMOTE_AUTH_TYPE=password

# SSH 私钥路径（SYNC_REMOTE_AUTH_TYPE=sshkey 时使用；留空默认 ~/.ssh/id_rsa）
SYNC_REMOTE_KEY_PATH=

# SSH 密码（SYNC_REMOTE_AUTH_TYPE=password 时必填）
# 安全约定: SYNC_REMOTE_PASSWORD_ENCRYPTED=true（默认）时，此处必须填写
# Base64 编码后的密码，不要写明文。生成方式:
#     echo -n '你的密码' | base64
# 把输出的编码串填到下面；设为 false 则按明文处理（不推荐）
SYNC_REMOTE_PASSWORD=
SYNC_REMOTE_PASSWORD_ENCRYPTED=true

# 远端项目部署路径（远端项目根目录）：bundle 与 bundle.meta 会上传到
# <该路径>/bundles/ 子目录，部署服务器上的 stage-bundle 也从该子目录
# 读取 bundle 与元信息并解压替换 <该路径>/src/
SYNC_REMOTE_PATH=
