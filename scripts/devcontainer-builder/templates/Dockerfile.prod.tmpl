# 由 scripts/devcontainer-builder 生成，请勿手工编辑。
# 平台: {{DOCKER_PLATFORM}} | 基础镜像: {{BASE_IMAGE}} | wheel 标签: {{PIP_PLATFORM_TAG}}
# 预装语言环境 (target_codec): {{TARGET_CODEC}}
# 说明: 基础镜像固定为 slim-bookworm（glibc 2.36），glibc 参数仅控制 pip download
#       下载 wheel 时选用的 manylinux 标签（低版本标签的 wheel 可在高版本 glibc 运行）。
{{NODE_STAGE}}{{GO_STAGE}}FROM --platform={{DOCKER_PLATFORM}} {{BASE_IMAGE}} AS prod

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
{{GO_BLOCK}}
# 时区（内置启用）：TZ=Asia/Shanghai（UTC+8），配合 tzdata 生效
{{TZ_ENV_BLOCK}}
{{APT_BLOCK}}{{CUSTOM_INSTALL_BLOCK}}{{ORACLE_BLOCK}}{{NODE_BLOCK}}{{FRAMEWORK_BLOCK}}
WORKDIR /app

{{INSTALL_BLOCK}}
{{PLAYWRIGHT_BLOCK}}
# ---- 默认启动脚本（镜像 ENTRYPOINT）----
# 默认行为：cd /app 后运行预置入口（python main.py / go run main.go）。
# docker-compose.yml 把项目根的 docker-run.sh 只读挂载覆盖镜像内副本，
# 修改启动方式直接改项目根的 docker-run.sh 即可，无需重建镜像。
COPY docker-run.sh {{DOCKER_RUN_CONTAINER_PATH}}
RUN chmod 755 {{DOCKER_RUN_CONTAINER_PATH}}
ENTRYPOINT ["{{DOCKER_RUN_CONTAINER_PATH}}"]
{{DEV_STAGE}}
