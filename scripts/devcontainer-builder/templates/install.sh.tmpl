#!/usr/bin/env bash
# 由 scripts/devcontainer-builder 生成（时间戳: {{TS}}，镜像 TAG: {{TAG}}），请勿手工编辑。
#
# 用法：把本脚本与 devcontainer-src_{{ARCH}}_{{TS}}.tgz（以及 clean.sh /
# images.txt）放在同一目录（建议放在项目根目录的 downloads/ 下），然后执行：
#   bash install.sh /path/to/your/project-root     # 在 downloads/ 中即 bash install.sh ../
#   bash install.sh --load /path/to/your/project-root
#                                                  # 安装开始前自动 docker load
#                                                  # 同目录的镜像归档 tgz
#   bash install.sh --no-load /path/to/your/project-root
#                                                  # 照常安装，但跳过镜像导入
#                                                  # （覆盖 --load / -d 的自动导入）
#   bash install.sh --load-only                    # 只执行 docker load 同目录的
#                                                  # 镜像归档，不做任何安装操作
#   bash install.sh --load --load-target dev ../   # 安装并只导入 dev 镜像（不导入
#                                                  # prod；sidecar 镜像仍会导入）
#   bash install.sh --load-only --load-target prod # 只导入 prod 镜像（不导入 dev）
#   bash install.sh -d | --default                 # 一键默认安装：自动启用 --load，
#                                                  # 无需传路径，项目根固定为 ../，
#                                                  # 应用源码放入 ../{{APP_DIR}}/
#   bash install.sh -h | --help                    # 查看用法、选项与退出码
# （Artifact 的 zip 解压后可能丢失可执行权限，统一用 `bash install.sh` 调用）
#
# 作用（流程：在服务器上新建空仓库文件夹 → mkdir downloads → 把 bundle zip 放入
#   downloads/ 解压 → 在 downloads/ 内执行本脚本）：
#   1. 把 devcontainer-src_{{ARCH}}_{{TS}}.tgz 解压到临时目录（安装完成后清理，
#      不在项目内保留副本）；
#   2. 把包内 docker-compose.yml.tpl 原样复制到 INSTALL_PATH/docker/，命名为
#      去掉 .tpl 后缀的 docker-compose.yml（模板内 ${SRC_ROOT:-../{{APP_DIR}}/}
#      与 ${SRC_ROOT_NAME:-app} 由 docker compose 运行时解析；compose 项目
#      目录 = docker/，SRC_ROOT 相对 docker/ 解析，../ 即项目根）
#   3. 把 Makefile / devcontainer.json（workflow 输入参数快照）安装到项目根，
#      把 Dockerfile（联网重建版）/ Dockerfile.addon（离线补装，build.sh 引用）/
#      build.sh / docker-run.sh / init-deps.sh / .env.example 安装到
#      INSTALL_PATH/docker/，requirements.txt 安装到应用源码目录
#      （{{APP_DIR}}/requirements.txt），包内 scripts/（manifest.txt /
#      push-bundle.sh / apply-bundle.sh / rollback-bundle.sh / clean-images.sh /
#      .env.example）安装到 <INSTALL_PATH>/scripts/，同时安装/合并
#      .dockerignore 与 .gitignore，并安装项目根 AGENTS.md（AI Agent 使用约定）
#   4. 在 INSTALL_PATH/docs 下创建 .gitkeep；README.md 安装为
#      docs/DEVCONTAINER.md。deps/ 不再默认安装：需要离线依赖目录时在项目根
#      执行 bash docker/init-deps.sh 生成 docker/deps/
#   5. 准备应用源码目录：single_app 布局为 INSTALL_PATH/{{APP_DIR}}（compose
#      默认把 ../{{APP_DIR}}/ 挂载为 /app），requirements.txt 与 package.json
#      都放在 {{APP_DIR}}/；febe_separation 布局为 api/ + web/，
#      requirements.txt 放 api/、package.json 放 web/。按预装语言环境放置
#      占位入口（api 侧 main.py / main.go；web 侧 index.html）
#   6. nginx_mode 启用时创建 <INSTALL_PATH>/nginx/ 并安装配置模板 default.conf
#      （nginx_service 由独立 nginx 服务挂载；nginx_binary 由容器内 nginx 加载）
#   7. docker-run.sh（容器默认启动脚本）安装到 docker/ 后由 compose 只读
#      挂载覆盖镜像内副本，改 docker/docker-run.sh 即可调整启动方式（无需重建镜像）
set -euo pipefail

NEEDS_MAIN_PY={{PYTHON_ENABLED}}   # 1 = target_codec 预装 Python（占位 main.py）
NEEDS_MAIN_GO={{GO_ENABLED}}       # 1 = target_codec 预装 Golang（占位 main.go）

# ---------- 输出着色（仅终端着色；重定向/CI/NO_COLOR 时自动退化为无色） ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
else
    C_RESET=''; C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''
fi
err()  { printf '%s\n' "${C_RED}错误:${C_RESET} $*"; }                  # 错误（红）
step() { printf '%s\n' "${C_BOLD}${C_CYAN}==> $*${C_RESET}"; }          # 阶段标题（青色加粗）
ok()   { printf '%s\n' "  ${C_GREEN}✓${C_RESET} $*"; }                  # 单项成功（绿勾）
note() { printf '%s\n' "  ${C_YELLOW}$*${C_RESET}"; }                   # 提示（黄）

usage() {
    local code=${1:-2}
    cat <<EOF
${C_BOLD}用法:${C_RESET} bash $0 [--load | --no-load] [--load-target <dev|prod|app|all>] <INSTALL_PATH>
       bash $0 -d | --default [--no-load] [--load-target <dev|prod|app|all>]
       bash $0 --load-only [--load-target <dev|prod|app|all>]

在项目根目录安装离线 devcontainer 开发环境：解压源码/模板包到临时目录，安装
Makefile 与 devcontainer.json（workflow 输入参数快照）到项目根；Dockerfile
（联网重建版）、Dockerfile.addon（离线补装）、build.sh、docker-run.sh、
init-deps.sh、docker-compose.yml 与 .env.example 安装到 <项目根>/docker/；
requirements.txt 安装到应用源码目录（{{APP_DIR}}/requirements.txt）；部署辅助
脚本 manifest.txt / push-bundle.sh / apply-bundle.sh / rollback-bundle.sh /
clean-images.sh（及其变量模板 scripts/.env.example）安装到 <项目根>/scripts/；
安装/合并 .dockerignore / .gitignore 与项目根 AGENTS.md（AI Agent 使用约定），
并准备应用源码目录（single_app={{APP_DIR}}/；febe_separation=api/ + web/）。

${C_BOLD}参数:${C_RESET}
  INSTALL_PATH          项目根目录（必须已存在）。Makefile / AGENTS.md /
                        devcontainer.json / .dockerignore / .gitignore 安装到
                        INSTALL_PATH；docker 相关文件安装到
                        <INSTALL_PATH>/docker/；快速上手说明安装为
                        <INSTALL_PATH>/docs/DEVCONTAINER.md；
                        应用源码放在 <INSTALL_PATH>/{{APP_DIR}}（compose 默认
                        挂载为 /app）。

${C_BOLD}选项:${C_RESET}
  -d, --default         默认安装：自动启用 --load，且无需指定 INSTALL_PATH，
                        项目根固定为 ../，应用源码放入 ../{{APP_DIR}}/。该选项为
                        顶级覆盖：忽略同时给出的 INSTALL_PATH 及其它相关自定义设置。
  --load                安装开始前自动在脚本所在目录查找
                        devcontainer-docker-images_*.tgz 并执行 docker load
                        （等效于手动 docker load -i 该归档）。
  --no-load             执行除镜像导入（Load）以外的全部操作：照常解压、安装
                        文件并准备源码目录，但不执行 docker load；可覆盖
                        --load 与 -d/--default 的自动导入。
  --load-only           只执行镜像导入：在脚本所在目录查找
                        devcontainer-docker-images_*.tgz 并 docker load，
                        随后立即退出，不执行任何安装操作（无需 INSTALL_PATH）。
  --load-target <t>     配合 --load / --load-only / -d 使用：只导入指定镜像，
                        t ∈ dev|prod|app|all（默认 all = 导入归档内全部镜像）。
                        dev  = 仅导入 dev 镜像（不导入 prod）
                        prod = 仅导入 prod 镜像（不导入 dev）
                        app  = 应用服务使用的镜像（= prod；仅 dev 镜像模式下
                               为 dev 镜像）
                        sidecar 镜像（nginx / postgres / mysql / mongo /
                        代码同步工具 push 运行环境，如已打包）在任何 target
                        下都会一并导入。
  -h, --help            显示本帮助并退出。

${C_BOLD}示例:${C_RESET}
  bash install.sh ../              # 在项目根目录的 downloads/ 中安装到上一级项目根
  bash install.sh --load ../       # 同上，并在安装前自动导入镜像
  bash install.sh --load --load-target dev ../
                                   # 同上，但只导入 dev 镜像（不含 prod）
  bash install.sh --no-load ../    # 只做安装，不导入镜像（镜像稍后手动 docker load）
  bash install.sh --load-only      # 只导入镜像，不做安装
  bash install.sh --load-only --load-target prod
                                   # 只导入 prod 镜像（部署用），不做安装
  bash install.sh -d               # 一键默认：自动导入镜像，安装到 ../（源码在 ../{{APP_DIR}}/）
  bash install.sh -d --no-load     # 一键默认安装，但跳过镜像导入
  bash install.sh -h               # 查看本帮助

${C_BOLD}退出码:${C_RESET}
  0  安装成功（或使用 -h/--help 查看帮助）
  1  安装失败（前置校验不通过、缺少 tgz、docker load 失败等）
  2  参数错误

${C_BOLD}说明:${C_RESET}
  src 包只解压到临时目录，安装完成后清理，项目内不留副本。
EOF
    exit "$code"
}

# ---------- 镜像导入（--load / --load-only 共用；--load-target 选择导入哪些镜像） ----------
find_images_tgz() {
    command -v docker >/dev/null 2>&1 \
        || { err "镜像导入需要 docker 命令，但未在 PATH 中检测到 docker"; exit 1; }
    local -a img_tgzs
    shopt -s nullglob
    img_tgzs=("$SCRIPT_DIR"/devcontainer-docker-images_*.tgz)
    shopt -u nullglob
    if [ "${#img_tgzs[@]}" -eq 0 ]; then
        err "未在 $SCRIPT_DIR 找到 devcontainer-docker-images_*.tgz"
        echo "      （镜像导入需与镜像归档放在同一目录，即 install.sh 旁边）"
        exit 1
    fi
    if [ "${#img_tgzs[@]}" -gt 1 ]; then
        err "$SCRIPT_DIR 下有多个镜像归档，请只保留本次使用的那个："
        printf '  %s\n' "${img_tgzs[@]}"
        exit 1
    fi
    printf '%s\n' "${img_tgzs[0]}"
}

load_images_all() {
    local img_tgz=$1
    step "导入镜像归档（docker load，全部镜像）"
    docker load -i "$img_tgz"
    ok "已导入 ${C_BOLD}${img_tgz}${C_RESET}"
}

# --load-target dev|prod|app：docker load 本身不支持按镜像过滤，这里从
# docker save 归档中读出 manifest.json，筛出目标镜像（外加 sidecar 镜像）的
# config 与 layer，重建一个临时归档后再 docker load。
load_images_filtered() {
    local img_tgz=$1 target=$2; shift 2
    local -a want=("$@")
    local manifest entry tags match cfg w found=0
    local tmp
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/devc-load.XXXXXX") \
        || { err "无法创建临时目录（按 target 过滤导入需要）"; exit 1; }
    # 提前展开临时目录字面量：EXIT 时函数已返回，local 变量在 set -u 下不可见
    trap "rm -rf '$tmp'" EXIT
    if ! manifest=$(tar xzOf "$img_tgz" manifest.json 2>/dev/null) \
        && ! manifest=$(tar xzOf "$img_tgz" ./manifest.json 2>/dev/null); then
        err "镜像归档缺少 manifest.json，无法按 --load-target=$target 过滤"
        echo "      （可去掉 --load-target 使用默认行为导入归档内全部镜像）"
        exit 1
    fi
    local -a keep=("manifest.json")
    while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        tags=$(printf '%s' "$entry" | grep -o '"RepoTags": *\[[^]]*\]' | head -n 1 || true)
        match=0
        for w in "${want[@]}"; do
            case "$tags" in *"\"$w\""*) match=1; break ;; esac
        done
        [ "$match" = "1" ] || continue
        found=$((found + 1))
        cfg=$(printf '%s' "$entry" | sed -n 's/.*"Config": *"\([^"]*\)".*/\1/p')
        [ -n "$cfg" ] && keep+=("$cfg")
        while IFS= read -r layer; do
            [ -n "$layer" ] && keep+=("$layer")
        done < <(printf '%s' "$entry" \
            | grep -o '"Layers": *\[[^]]*\]' \
            | sed -e 's/^"Layers": *\[//' -e 's/\]$//' -e 's/","/\n/g' -e 's/"//g' \
            || true)
    done <<EOF
$(printf '%s' "$manifest" | sed 's/},{/}\n{/g')
EOF
    if [ "$found" -eq 0 ]; then
        err "镜像归档中没有匹配 --load-target=$target 的镜像（期望: ${want[*]}）"
        echo "      （本次构建可能未构建该镜像；可去掉 --load-target 导入全部镜像）"
        exit 1
    fi
    printf '%s\n' "${keep[@]}" | awk 'NF' | sort -u > "$tmp/files.list"
    step "按 --load-target=$target 过滤导入（${want[*]}）"
    tar xzf "$img_tgz" -C "$tmp" -T "$tmp/files.list" \
        || { err "解包镜像归档失败（按 target 过滤导入）"; exit 1; }
    tar cf - -C "$tmp" -T "$tmp/files.list" | docker load
    ok "已按 target=$target 导入 ${C_BOLD}$img_tgz${C_RESET} 中的目标镜像"
}

load_images() {
    local img_tgz
    img_tgz=$(find_images_tgz)
    if [ "$LOAD_TARGET" = "all" ]; then
        load_images_all "$img_tgz"
        return
    fi
    # 目标镜像 + sidecar 镜像（任何 target 都一并导入）
    local -a want
    case "$LOAD_TARGET" in
        dev)  want=({{DEV_IMAGE}}) ;;
        prod) want=({{PROD_IMAGE}}) ;;
        app)  want=({{APP_IMAGE}}) ;;
    esac
    local w
    for w in {{SIDECAR_IMAGES}}; do
        want+=("$w")
    done
    load_images_filtered "$img_tgz" "$LOAD_TARGET" "${want[@]}"
}

LOAD_IMAGES=0
LOAD_ONLY=0
NO_LOAD=0
DEFAULT_MODE=0
LOAD_TARGET=all
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage 0 ;;
        -d|--default) DEFAULT_MODE=1; shift ;;
        --load)    LOAD_IMAGES=1; NO_LOAD=0; shift ;;
        --no-load) LOAD_IMAGES=0; NO_LOAD=1; shift ;;
        --load-only) LOAD_ONLY=1; shift ;;
        --load-target)
            [ "$#" -ge 2 ] || { err "--load-target 需要一个值: dev|prod|app|all"; usage; }
            case "$2" in
                dev|prod|app|all) LOAD_TARGET=$2 ;;
                *) err "--load-target 仅支持 dev|prod|app|all: $2"; usage ;;
            esac
            shift 2 ;;
        --)        shift; break ;;
        -*)        err "未知选项: $1"; usage ;;
        *)         break ;;
    esac
done

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)

if [ "$LOAD_ONLY" = "1" ]; then
    # --load-only：只导入镜像归档，不解析 INSTALL_PATH、不写任何文件
    [ "$DEFAULT_MODE" = "0" ] || note "--load-only 已忽略 -d/--default（仅导入镜像）"
    [ "$NO_LOAD" = "0" ] || note "--load-only 已忽略 --no-load（仅导入镜像）"
    [ "$#" -eq 0 ] || note "--load-only 已忽略参数: $*（仅导入镜像）"
    load_images
    exit 0
fi

if [ "$DEFAULT_MODE" = "1" ]; then
    # -d/--default 为顶级覆盖：强制自动导入镜像，并固定项目根为 ../（与 CWD
    # 相对），应用源码放入 ../{{APP_DIR}}/（compose 默认把 ./{{APP_DIR}}/ 挂载为
    # /app），忽略用户给出的路径与相关选项；显式 --no-load 时跳过镜像导入。
    LOAD_IMAGES=1
    if [ "$NO_LOAD" = "1" ]; then
        LOAD_IMAGES=0
        note "-d/--default 已按 --no-load 跳过镜像导入"
    fi
    if [ "$#" -gt 0 ]; then
        note "-d/--default 已忽略自定义路径: $*（固定使用 ../ 作为项目根，源码目录 ../{{APP_DIR}}/）"
    fi
    INSTALL_PATH="../"
else
    [ "$#" -eq 1 ] || usage
    INSTALL_PATH=$1
fi
[ -d "$INSTALL_PATH" ] || { err "INSTALL_PATH 不是目录: $INSTALL_PATH"; exit 1; }
INSTALL_PATH=$(cd "$INSTALL_PATH" && pwd -P)

# --load-target 只在会导入镜像（--load / --load-only / -d 且未被 --no-load 覆盖）时生效
if [ "$LOAD_TARGET" != "all" ] && [ "$LOAD_IMAGES" = "0" ] && [ "$LOAD_ONLY" = "0" ]; then
    note "--load-target 已忽略（未指定 --load / --load-only / -d，本次不会导入镜像）"
    LOAD_TARGET=all
fi

# ---------- 可选：--load 在安装开始前自动导入镜像归档 ----------
if [ "$LOAD_IMAGES" = "1" ]; then
    load_images
fi

shopt -s nullglob
tgzs=("$SCRIPT_DIR"/devcontainer-src_*.tgz)
shopt -u nullglob
if [ "${#tgzs[@]}" -eq 0 ]; then
    err "未在 $SCRIPT_DIR 找到 devcontainer-src_*.tgz（请与安装脚本放在同一目录，"
    echo "      建议把 bundle zip 放到项目根目录 downloads/ 下解压后执行 bash install.sh ../）"
    exit 1
fi
if [ "${#tgzs[@]}" -gt 1 ]; then
    err "$SCRIPT_DIR 下有多个 src 包，请只保留本次使用的那个："
    printf '  %s\n' "${tgzs[@]}"
    exit 1
fi
TGZ=${tgzs[0]}

COMPOSE_FILE="$INSTALL_PATH/docker/docker-compose.yml"
DOCKER_DIR="$INSTALL_PATH/docker"
# 应用源码目录（compose 项目目录 = docker/，默认把 ../{{APP_DIR}}/ 挂载为 /app；
# febe_separation 布局另有前端目录 {{WEB_DIR}}/）
APP_DIR_SRC="$INSTALL_PATH/{{APP_DIR}}"
WEB_DIR_SRC="$INSTALL_PATH/{{WEB_DIR}}"

# 复制到 docker/ 目录的 docker 相关文件：包内文件名 -> docker/ 下文件名
# （Dockerfile = 联网重建版，compose build / make build 使用，context 为
#   项目根、COPY {{APP_DIR}}/requirements.txt；Dockerfile.addon = 离线补装版，
#   build.sh 引用；build.sh / docker-run.sh / init-deps.sh 按原名安装。
#   requirements.txt 安装到应用源码目录，见 COPY_APP_FILES）
COPY_DOCKER_FILES=("Dockerfile:Dockerfile" "Dockerfile.addon:Dockerfile.addon" "build.sh:build.sh" "docker-run.sh:docker-run.sh" "init-deps.sh:init-deps.sh")

# 安装到应用源码目录的文件：requirements.txt（联网重建版 Dockerfile 的 COPY
# 依赖；容器内挂载为 /app/requirements.txt，可直接查看/修改）。包内路径为
# {{APP_DIR}}/requirements.txt（与 CI 构建上下文一致）
COPY_APP_FILES=("{{APP_DIR}}/requirements.txt:requirements.txt")

# 安装到项目根 scripts/ 的部署辅助脚本（包内 scripts/ -> <根>/scripts/，
# Makefile 的 push/apply/rollback/clean 目标按 ./scripts/<脚本> 调用）
SCRIPTS_FILES=("scripts/.env.example" "scripts/manifest.txt" "scripts/push-bundle.sh" "scripts/apply-bundle.sh" "scripts/rollback-bundle.sh" "scripts/clean-images.sh")

# devcontainer.json（workflow 输入参数快照）：bundle zip 顶层随 install.sh 分发，
# 与 README.md 一样安装到项目根目录
HAS_DEVCONTAINER_JSON=0
[ -f "$SCRIPT_DIR/devcontainer.json" ] && HAS_DEVCONTAINER_JSON=1

# ---------- 前置校验：先全部检查，再动手写盘（失败不留半套安装） ----------
fail=0
if [ -e "$COMPOSE_FILE" ]; then
    err "$COMPOSE_FILE 已存在，避免覆盖你的 compose 配置，安装终止。"
    echo "  请先移动/重命名该文件后重试。"
    fail=1
fi
# docker/ 目录文件（Makefile 仍在项目根，单独检查）
for pair in "${COPY_DOCKER_FILES[@]}"; do
    dst_name=${pair##*:}
    if [ -e "$DOCKER_DIR/$dst_name" ]; then
        err "$DOCKER_DIR/$dst_name 已存在，避免覆盖你自己的文件，安装终止。"
        echo "  请先移动/重命名后重试（如为旧版安装残留，确认无需保留后删除）。"
        fail=1
    fi
done
if [ -e "$INSTALL_PATH/Makefile" ]; then
    err "$INSTALL_PATH/Makefile 已存在，避免覆盖你自己的文件，安装终止。"
    echo "  请先移动/重命名后重试（如为旧版安装残留，确认无需保留后删除）。"
    fail=1
fi
# requirements.txt 安装到应用源码目录
for pair in "${COPY_APP_FILES[@]}"; do
    dst_name=${pair##*:}
    if [ -e "$APP_DIR_SRC/$dst_name" ]; then
        err "$APP_DIR_SRC/$dst_name 已存在，避免覆盖你自己的文件，安装终止。"
        echo "  请先移动/重命名后重试。"
        fail=1
    fi
done
# 项目根 AGENTS.md（AI Agent 使用约定）
if [ -e "$INSTALL_PATH/AGENTS.md" ]; then
    err "$INSTALL_PATH/AGENTS.md 已存在，避免覆盖你自己的文件，安装终止。"
    echo "  请先移动/重命名后重试。"
    fail=1
fi
# 部署辅助脚本安装到 <根>/scripts/：仅当目标脚本同名冲突时终止
# （scripts/ 目录本身可能属于用户项目，目录已存在但无同名文件时正常合并安装）
for f in "${SCRIPTS_FILES[@]}"; do
    if [ -e "$INSTALL_PATH/$f" ]; then
        err "$INSTALL_PATH/$f 已存在，避免覆盖你自己的文件，安装终止。"
        echo "  请先移动/重命名后重试（如为旧版安装残留，确认无需保留后删除）。"
        fail=1
    fi
done
if [ -e "$INSTALL_PATH/docs/DEVCONTAINER.md" ]; then
    err "$INSTALL_PATH/docs/DEVCONTAINER.md 已存在，避免覆盖你自己的文件，安装终止。"
    echo "  请先移动/重命名后重试。"
    fail=1
fi
if [ "$HAS_DEVCONTAINER_JSON" = "1" ] && [ -e "$INSTALL_PATH/devcontainer.json" ]; then
    err "$INSTALL_PATH/devcontainer.json 已存在，避免覆盖你自己的文件，安装终止。"
    echo "  请先移动/重命名后重试。"
    fail=1
fi
# nginx 配置模板（nginx_mode 启用时）：目标 default.conf 已存在时终止
if [ "{{NGINX_MODE}}" != "none" ] && [ -e "$INSTALL_PATH/nginx/default.conf" ]; then
    err "$INSTALL_PATH/nginx/default.conf 已存在，避免覆盖你自己的文件，安装终止。"
    echo "  请先移动/重命名后重试。"
    fail=1
fi
# 前端框架（pack_in_artifact 模式）：bundle 内必须只有一个 <框架标签>-*.tgz，
# 且目标 vendor 目录不与用户现有文件冲突
if [ "{{FRAMEWORK_ENABLED}}" = "1" ] && [ "{{FRAMEWORK_MODE}}" = "pack_in_artifact" ]; then
    shopt -s nullglob
    fw_tgzs=("$SCRIPT_DIR"/{{FRAMEWORK_VENDOR_LABEL}}-*.tgz)
    shopt -u nullglob
    if [ "${#fw_tgzs[@]}" -eq 0 ]; then
        err "未在 $SCRIPT_DIR 找到 {{FRAMEWORK_VENDOR_LABEL}}-*.tgz（pack in artifact 模式需要 bundle 内的 {{FRAMEWORK_NAME}} 离线包，与 install.sh 放在同一目录）"
        fail=1
    elif [ "${#fw_tgzs[@]}" -gt 1 ]; then
        err "$SCRIPT_DIR 下有多个 {{FRAMEWORK_VENDOR_LABEL}}-*.tgz，请只保留本次使用的那个："
        printf '  %s\n' "${fw_tgzs[@]}"
        fail=1
    else
        FW_TGZ=${fw_tgzs[0]}
        FW_VER=${FW_TGZ##*/{{FRAMEWORK_VENDOR_LABEL}}-}
        FW_VER=${FW_VER%.tgz}
        FW_VENDOR_DIR="$INSTALL_PATH/{{VENDOR_BASE_DIR}}/{{FRAMEWORK_VENDOR_DIR}}/{{FRAMEWORK_VENDOR_LABEL}}-$FW_VER"
        if [ -e "$FW_VENDOR_DIR" ]; then
            err "$FW_VENDOR_DIR 已存在，避免覆盖你自己的文件，安装终止。"
            echo "  请先移动/重命名后重试。"
            fail=1
        fi
    fi
fi
[ "$fail" = "0" ] || exit 1

# ---------- 安装 ----------
# src 包解压到临时目录：安装完成后清理，项目内不留副本（无原始副本目录）
DEST=$(mktemp -d "${TMPDIR:-/tmp}/devc-install.XXXXXX") \
    || { err "无法创建临时目录（解压 src 包需要）"; exit 1; }
trap 'rm -rf "$DEST"' EXIT

step "解压 src 包到临时目录"
tar xzf "$TGZ" -C "$DEST" --strip-components=1

TPL="$DEST/docker-compose.yml.tpl"
[ -f "$TPL" ] || { err "包内缺少 docker-compose.yml.tpl: $TPL"; exit 1; }

# compose 运行文件：复制模板到 docker/ 目录，仅去掉 .tpl 后缀（不做任何渲染，
# ${SRC_ROOT:-../{{APP_DIR}}/} / ${SRC_ROOT_NAME:-app} 由 docker compose 运行时解析）
step "复制 compose 模板到 docker/"
mkdir -p "$DOCKER_DIR"
cp "$TPL" "$COMPOSE_FILE"
ok "已创建 ${C_BOLD}$COMPOSE_FILE${C_RESET}"

# docker/ 目录文件：从临时目录复制到 <根>/docker/（映射见上）
step "安装 docker/ 目录文件"
for pair in "${COPY_DOCKER_FILES[@]}"; do
    src_name=${pair%%:*}
    dst_name=${pair##*:}
    cp "$DEST/$src_name" "$DOCKER_DIR/$dst_name"
    ok "已创建 $DOCKER_DIR/$dst_name ${C_DIM}(来自 $src_name)${C_RESET}"
done
# zip/tar 传输可能丢失可执行位，显式恢复
chmod 755 "$DOCKER_DIR/build.sh" "$DOCKER_DIR/docker-run.sh" "$DOCKER_DIR/init-deps.sh"

# Makefile 安装到项目根（所有 make 命令都在项目根执行，COMPOSE_FILE 指向
# docker/docker-compose.yml）
step "安装项目根 Makefile"
cp "$DEST/Makefile" "$INSTALL_PATH/Makefile"
ok "已创建 $INSTALL_PATH/Makefile"

# requirements.txt 安装到应用源码目录（联网重建版 Dockerfile 按
# context = 项目根 COPY {{APP_DIR}}/requirements.txt）
step "安装 requirements.txt 到应用源码目录"
mkdir -p "$APP_DIR_SRC"
for pair in "${COPY_APP_FILES[@]}"; do
    src_name=${pair%%:*}
    dst_name=${pair##*:}
    cp "$DEST/$src_name" "$APP_DIR_SRC/$dst_name"
    ok "已创建 $APP_DIR_SRC/$dst_name"
done

# 项目根 AGENTS.md：AI Agent 使用约定（完全离线开发 / 容器内操作，
# 详细手册 docs/DEVCONTAINER.md）
step "安装项目根 AGENTS.md"
cp "$DEST/AGENTS.md" "$INSTALL_PATH/AGENTS.md"
ok "已创建 $INSTALL_PATH/AGENTS.md（AI Agent 使用约定）"

# 部署辅助脚本：包内 scripts/ -> <根>/scripts/（Makefile 的 push/apply/
# rollback/clean 目标按 ./scripts/<脚本> 调用；前置校验已确认无同名冲突，
# scripts/ 目录已存在但无同名文件时正常合并安装）
step "安装部署辅助脚本到 scripts/"
mkdir -p "$INSTALL_PATH/scripts"
for f in "${SCRIPTS_FILES[@]}"; do
    cp "$DEST/$f" "$INSTALL_PATH/$f"
    ok "已创建 $INSTALL_PATH/$f"
done
# zip/tar 传输可能丢失可执行位，显式恢复
chmod 755 "$INSTALL_PATH/scripts/push-bundle.sh" "$INSTALL_PATH/scripts/apply-bundle.sh" "$INSTALL_PATH/scripts/rollback-bundle.sh" "$INSTALL_PATH/scripts/clean-images.sh"

# docker/.env.example：docker-compose.yml 运行时变量模板（key 与 compose 中
# ${VAR:-默认值} 一致，docker compose 的项目目录为 docker/，自动读取
# docker/.env；需要覆盖默认值时 cp docker/.env.example docker/.env 再改）。
# 仅在缺失时安装——已存在时保留原文件、不中断安装
# （部署脚本的 SYNC_REMOTE_* 变量模板随脚本安装在 scripts/.env.example）
if [ -e "$DOCKER_DIR/.env.example" ]; then
    note "$DOCKER_DIR/.env.example 已存在，保留原文件（compose 变量默认值可参考包内副本）"
else
    cp "$DEST/.env.example" "$DOCKER_DIR/.env.example"
    ok "已创建 $DOCKER_DIR/.env.example（docker-compose.yml 运行时变量模板）"
fi

# docs/.gitkeep 与 docs/DEVCONTAINER.md：快速上手说明由包内 README.md 复制
# 改名而来（根目录不放 README.md）；.gitkeep 保证 docs/ 目录结构可被 git 跟踪
step "安装 docs/ 说明文件"
mkdir -p "$INSTALL_PATH/docs"
touch "$INSTALL_PATH/docs/.gitkeep"
ok "已创建 $INSTALL_PATH/docs/.gitkeep"
cp "$DEST/README.md" "$INSTALL_PATH/docs/DEVCONTAINER.md"
ok "已创建 $INSTALL_PATH/docs/DEVCONTAINER.md ${C_DIM}(来自包内 README.md)${C_RESET}"

# devcontainer.json：本次 workflow 输入参数快照（与 install.sh 同目录分发），
# 与 README.md 一样安装到项目根目录（前置校验已确认无同名冲突）
if [ "$HAS_DEVCONTAINER_JSON" = "1" ]; then
    cp "$SCRIPT_DIR/devcontainer.json" "$INSTALL_PATH/devcontainer.json"
    ok "已安装 $INSTALL_PATH/devcontainer.json（workflow 输入参数快照）"
fi

# nginx 配置模板（nginx_mode 启用时）：安装到 <根>/nginx/default.conf
# （nginx_service 模式由独立 nginx 服务挂载；nginx_binary 模式由容器内
# nginx 加载——两种模式都可手工修改，修改随 manifest 的 nginx/ 条目同步）
if [ "{{NGINX_MODE}}" != "none" ]; then
    step "安装 nginx 配置模板"
    mkdir -p "$INSTALL_PATH/nginx"
    cp "$DEST/nginx/default.conf" "$INSTALL_PATH/nginx/default.conf"
    ok "已创建 $INSTALL_PATH/nginx/default.conf（nginx 配置模板，可按需修改）"
fi

# ---------- compose 命令检测：v2 插件优先，仅有 v1 独立版时改写 Makefile ----------
COMPOSE_MODE="missing"
if docker compose version >/dev/null 2>&1; then
    COMPOSE_MODE="v2"
elif command -v docker-compose >/dev/null 2>&1; then
    COMPOSE_MODE="v1"
    sed 's|^COMPOSE := docker compose |COMPOSE := docker-compose |' \
        "$INSTALL_PATH/Makefile" > "$INSTALL_PATH/Makefile.compose-tmp"
    mv "$INSTALL_PATH/Makefile.compose-tmp" "$INSTALL_PATH/Makefile"
    ok "未检测到 docker compose 插件，已将 Makefile 的 COMPOSE 改为 docker-compose"
fi

# .dockerignore / .gitignore：缺失时创建；已存在时仅追加缺失条目（不动原内容）
merge_ignore_file() {  # $1 = 包内文件名（与根目录目标同名）
    local src="$DEST/$1" dst="$INSTALL_PATH/$1" line added=0
    if [ ! -e "$dst" ]; then
        cp "$src" "$dst"
        ok "已创建 $INSTALL_PATH/$1"
        return
    fi
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        if ! grep -qxF -- "$line" "$dst"; then
            printf '%s\n' "$line" >> "$dst"
            added=1
        fi
    done < "$src"
    if [ "$added" = "1" ]; then
        ok "已合并 $INSTALL_PATH/$1 ${C_DIM}(仅追加缺失条目，原有内容未改动)${C_RESET}"
    else
        note "$INSTALL_PATH/$1 已包含全部条目，未修改"
    fi
}
step "安装 .dockerignore / .gitignore"
merge_ignore_file ".dockerignore"
merge_ignore_file ".gitignore"

# deps/ 离线依赖目录不再默认安装：需要离线补装 Python 包（docker/deps/wheels）
# 或离线安装前端依赖（docker/deps/packages）时，在项目根执行
#   bash docker/init-deps.sh
# 生成 docker/deps/ 目录结构与离线安装头（详见 docker/init-deps.sh 脚本头注释）。

# 应用源码目录（compose 默认把 ../{{APP_DIR}}/ 挂载为 /app）
step "准备应用源码目录"
mkdir -p "$APP_DIR_SRC"
ok "已准备源码目录 $APP_DIR_SRC（compose 挂载为 /app）"
if [ "{{SOURCE_LAYOUT}}" = "febe_separation" ]; then
    mkdir -p "$WEB_DIR_SRC"
    ok "已准备前端目录 $WEB_DIR_SRC（打包产物输出到 $WEB_DIR_SRC/dist/，nginx 启用时由 nginx 托管）"
fi
if [ "$NEEDS_MAIN_PY" = "1" ] && [ ! -e "$APP_DIR_SRC/main.py" ]; then
    cp "$DEST/main.py" "$APP_DIR_SRC/main.py"
    ok "已创建占位入口 $APP_DIR_SRC/main.py（docker-run.sh 默认运行 python main.py，请替换为真实入口）"
fi
if [ "$NEEDS_MAIN_GO" = "1" ] && [ ! -e "$APP_DIR_SRC/main.go" ]; then
    cp "$DEST/main.go" "$APP_DIR_SRC/main.go"
    ok "已创建占位入口 $APP_DIR_SRC/main.go（docker-run.sh 默认运行 go run main.go，请替换为真实入口）"
fi
# 前端占位：febe_separation 布局 web/ 放 index.html 样例与 package.json
# （预装 Node 时）；single_app 布局把 package.json 放入 app/
if [ "{{SOURCE_LAYOUT}}" = "febe_separation" ]; then
    if [ ! -e "$WEB_DIR_SRC/index.html" ]; then
        cp "$DEST/index.html" "$WEB_DIR_SRC/index.html"
        ok "已创建占位静态页 $WEB_DIR_SRC/index.html"
    fi
    if [ "{{NODE_ENABLED}}" = "1" ] && [ ! -e "$WEB_DIR_SRC/package.json" ]; then
        cp "$DEST/package.json" "$WEB_DIR_SRC/package.json"
        ok "已创建前端工程占位 $WEB_DIR_SRC/package.json（请替换为你的前端工程）"
    fi
elif [ "{{NODE_ENABLED}}" = "1" ] && [ ! -e "$APP_DIR_SRC/package.json" ]; then
    cp "$DEST/package.json" "$APP_DIR_SRC/package.json"
    ok "已创建前端工程占位 $APP_DIR_SRC/package.json（请替换为你的前端工程）"
fi

# ---------- 前端框架（pack_in_artifact）：解压到 <{{VENDOR_BASE_DIR}}>/vendor/<框架标签>-<version> ----------
if [ "{{FRAMEWORK_ENABLED}}" = "1" ] && [ "{{FRAMEWORK_MODE}}" = "pack_in_artifact" ]; then
    step "安装 {{FRAMEWORK_NAME}} 到 {{VENDOR_BASE_DIR}}/{{FRAMEWORK_VENDOR_DIR}}/"
    mkdir -p "$FW_VENDOR_DIR"
    # npm 包 tgz 顶层目录为 package/，strip 后内容即 <框架标签>-<version>/
    tar xzf "$FW_TGZ" -C "$FW_VENDOR_DIR" --strip-components=1
    ok "已安装 $FW_VENDOR_DIR（容器内 /{{VENDOR_BASE_DIR}}/{{FRAMEWORK_VENDOR_DIR}}/{{FRAMEWORK_VENDOR_LABEL}}-$FW_VER/，引用其 dist/ 静态资源）"
fi

# npm 离线包目录不再默认创建（deps/ 已交由 docker/init-deps.sh 按需生成），
# 仅提示位置；产物由 Npm Download Action 解压后放入该目录。
if [ "{{NODE_ENABLED}}" = "1" ]; then
    case "{{NPM_PACKAGES_DIR}}" in
        /*)
            note "npm 离线包目录为绝对路径 {{NPM_PACKAGES_DIR}}（需自行创建）"
            ;;
        *)
            note "npm 离线包目录: docker/{{NPM_PACKAGES_DIR}}（bash docker/init-deps.sh 生成后放入 Npm Download 产物的 packages/ 内容）"
            ;;
    esac
fi

echo ""
printf '%s\n' "${C_GREEN}${C_BOLD}== 安装完成 ==${C_RESET}"
echo "项目根目录: ${C_BOLD}$INSTALL_PATH${C_RESET}"
echo "docker/ 目录: ${C_BOLD}$DOCKER_DIR${C_RESET}（docker-compose.yml / Dockerfile* / build.sh / docker-run.sh / init-deps.sh / .env.example）"
echo "源码目录: ${C_BOLD}$APP_DIR_SRC${C_RESET}"
if [ "{{SOURCE_LAYOUT}}" = "febe_separation" ]; then
    echo "前端目录: ${C_BOLD}$WEB_DIR_SRC${C_RESET}"
fi
echo "同步清单: ${C_BOLD}$INSTALL_PATH/scripts/manifest.txt${C_RESET}（push/apply/rollback 的目标条目）"
note "离线依赖目录（可选）: cd \"$INSTALL_PATH\" && bash docker/init-deps.sh  # 生成 docker/deps/（补装 wheel / npm 离线包）"
note "一键清理镜像与容器: bash \"$SCRIPT_DIR/clean.sh\"  # compose down + 按 images.txt 删除镜像"
if [ "$LOAD_IMAGES" = "1" ]; then
    if [ "$DEFAULT_MODE" = "1" ]; then
        echo "镜像: 已导入（-d/--default）"
    else
        echo "镜像: 已导入（--load）"
    fi
    if [ "$LOAD_TARGET" != "all" ]; then
        echo "镜像: 按 --load-target=$LOAD_TARGET 只导入了指定镜像（其余镜像可去掉该选项重新导入）"
    fi
else
    if [ "$NO_LOAD" = "1" ]; then
        echo "镜像: 已跳过导入（--no-load）"
    fi
    echo "镜像: cd \"$SCRIPT_DIR\" && docker load -i devcontainer-docker-images_{{ARCH}}_{{TS}}.tgz"
fi
echo "启动: cd \"$INSTALL_PATH\" && ${C_GREEN}make check && make up && make logs${C_RESET}"
echo "更多: make help（完整说明见 docs/DEVCONTAINER.md）"
if [ "$COMPOSE_MODE" = "v1" ]; then
    note "已将 Makefile 的 COMPOSE 设为 docker-compose"
elif [ "$COMPOSE_MODE" = "missing" ]; then
    printf '%s\n' "${C_RED}${C_BOLD}警告: 未检测到 docker compose 或 docker-compose，make 命令无法执行，请先安装 docker compose。${C_RESET}"
fi
