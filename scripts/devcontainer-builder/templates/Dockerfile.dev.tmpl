# ---- dev 阶段：继承 prod，追加开发/交互工具 ----
FROM prod AS dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git curl vim make \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

{{DEV_NODE_BLOCK}}{{VUE_BLOCK}}{{DEV_PIP_BLOCK}}
WORKDIR /app

# CMD ["bash"] 供 make shell / dev 服务使用：镜像 ENTRYPOINT（docker-run.sh）
# 带参数调用时会透传 exec，因此 `docker compose run --rm dev <命令>` 行为不变
CMD ["bash"]
