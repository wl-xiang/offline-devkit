# docker-compose.yml 运行时环境变量模板：key 与 compose 中 ${VAR:-默认值}
# 一一对应，value 即 compose 内置的默认值。
# docker compose 会自动读取项目根目录的 .env（compose 文件所在目录）；
# 需要覆盖默认值时复制一份再改（.env 已被 .gitignore 忽略，不会误提交）：
#     cp .env.example .env

# 应用源码目录（compose 挂载为容器 /app；相对项目根解析，或绝对路径。
# 源码布局 {{SOURCE_LAYOUT}}：single = app/；api_web = api/（web/ 为前端目录））
SRC_ROOT=./{{APP_DIR}}/

# compose 项目名后缀（compose 项目名 = <镜像前缀>-<SRC_ROOT_NAME>）
SRC_ROOT_NAME=app

# 容器运行用户 UID/GID（默认 root:root；Makefile 会自动导出为当前用户，
# 一般无需在此设置。固定值时取消注释，root 运行用 0）
#HOST_UID=1000
#HOST_GID=1000
{{NPM_BLOCK}}{{ORACLE_BLOCK}}
