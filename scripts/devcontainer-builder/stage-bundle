#!/bin/sh
# 部署服务器端脚本：从 ./bundles/ 取最新的 SRC Bundle，用 bundle.meta 校验
# 完整性后解压替换到 ./src 目录。
# 纯 POSIX sh 实现——部署服务器无需 python/jq：tgz 解压只需 tar，SHA256 只需
# sha256sum（find -printf 为 GNU 扩展，Linux 均可用）。
#
# 用法（在部署目录中执行，目录下应有 publish-bundle 上传的 bundles/ 目录）:
#     ./stage-bundle              # 校验最新 bundle 后解压替换 ./src
#     ./stage-bundle -y           # 跳过交互确认直接执行
#     ./stage-bundle -c           # 保留最新一份 bundle，删除其余
#     ./stage-bundle --clean-all  # 删除全部 bundle 与遗留 sync.env
#     ./stage-bundle -h           # 打印用法
#
# 协议说明:
#     bundle 与 bundle.meta 固定位于 ./bundles/（publish-bundle 上传到远端
#     <项目路径>/bundles/）："最新"按 bundle 文件名中的时间戳判定
#     （bundle_<项目名>_<mmdd-HHMMSS>.tgz），不依赖文件修改时间。
#     bundle.meta 记录 BUNDLE_FILE / SHA256 等元信息，stage 前强制校验：
#     meta 与最新 bundle 文件名必须一致，且 SHA256 必须匹配，否则拒绝部署。
#     部署目录固定为 ./src —— 与 install.sh 默认把源码放入 ../src/
#     （项目根 ../ 下的 src）一致（compose 模板中 ${SRC_ROOT:-./src/}
#     把该目录挂载为容器内 /app）。
#
# 流程（默认模式）:
#     1. 找到 ./bundles/ 下文件名时间戳最新的 bundle_*.tgz
#     2. 读取 bundle.meta 校验 BUNDLE_FILE 一致性 + SHA256 完整性
#     3. 展示计划，等待手动输入 y 确认（-y 跳过）
#     4. 前置钩子: 自动 make down 下线服务（失败仅告警，不阻塞）
#     5. 解压到临时目录（bundle 损坏在此暴露，尚未触碰 ./src）
#     6. 备份旧版本到 bundles/backup_src_<mmdd-HHMMSS>.tgz，再清空 ./src
#     7. 把新代码移入 ./src（不会自动运行任何代码，完成后提示手动 make up）

set -eu

SRC_DIR="src"
BUNDLES_DIR="bundles"
META_FILE="bundle.meta"

usage() {
    cat <<'USAGE'
用法: ./stage-bundle [选项]

从 ./bundles/ 取文件名时间戳最新的 bundle_*.tgz，用 bundle.meta 校验完整性后
解压替换到 ./src 目录（不会自动运行任何代码）。
部署目录固定为 ./src —— compose 模板中 ${SRC_ROOT:-./src/} 把该目录挂载为容器内 /app。
执行前会自动 make down 下线服务；完成后请手动 make up 上线。

选项:
  （无参数）        取最新 bundle，校验后解压替换 ./src（含 make down 钩子与备份）
  -y, --yes         跳过交互确认直接执行
  -c, --clean       保留最新一份 bundle_*.tgz，删除其余
      --clean-all   删除全部 bundle_*.tgz 与遗留 sync.env
  -h, --help        显示本帮助并退出

示例:
  ./stage-bundle                # 常规部署：最新 bundle -> ./src
  ./stage-bundle -y             # 自动确认，直接部署
  ./stage-bundle -c             # bundles/ 瘦身：只保留最新一份 bundle
  ./stage-bundle --clean-all    # 清空所有 bundle
USAGE
}

die() {
    printf '错误: %s\n' "$*" >&2
    exit 1
}

# bundles/ 下文件名时间戳最新的 bundle_*.tgz（纯文件名，无则输出空）
find_newest_bundle() {
    find "$BUNDLES_DIR" -maxdepth 1 -type f -name 'bundle_*.tgz' -printf '%f\n' 2>/dev/null \
        | sort -r | head -n 1
}

# 从 bundles/bundle.meta 读取字段值（KEY=VALUE；取首个命中，去掉行尾 CR）
meta_get() {
    grep -E "^$1=" "$BUNDLES_DIR/$META_FILE" 2>/dev/null \
        | head -n 1 | cut -d '=' -f2- | tr -d '\r'
}

confirm() {
    if [ "$assume_yes" -eq 1 ]; then
        return 0
    fi
    printf '%s' "$1"
    IFS= read -r answer || { printf '\n'; return 1; }
    answer=$(printf '%s' "$answer" | tr -d ' \t' | tr '[:upper:]' '[:lower:]')
    [ "$answer" = "y" ]
}

# ---------- 参数 ----------
assume_yes=0
do_clean=0
do_clean_all=0
while [ "$#" -gt 0 ]; do
    case $1 in
        -y|--yes)    assume_yes=1 ;;
        -c|--clean)  do_clean=1 ;;
        --clean-all) do_clean_all=1 ;;
        -h|--help)   usage; exit 0 ;;
        *)           die "未知参数: $1（用 -h 查看用法）" ;;
    esac
    shift
done
if [ "$do_clean" -eq 1 ] && [ "$do_clean_all" -eq 1 ]; then
    die "-c/--clean 与 --clean-all 不能同时使用"
fi

# ---------- 清理模式：--clean-all ----------
if [ "$do_clean_all" -eq 1 ]; then
    printf '%s\n' "== --clean-all 将删除 =="
    found=0
    for f in "$BUNDLES_DIR"/bundle_*.tgz; do
        [ -e "$f" ] || continue
        printf '  %s\n' "$f"
        found=$((found + 1))
    done
    if [ -e "$BUNDLES_DIR/sync.env" ]; then
        printf '  %s\n' "$BUNDLES_DIR/sync.env（旧版遗留元信息文件）"
        found=$((found + 1))
    fi
    if [ "$found" -eq 0 ]; then
        printf '%s\n' "== $BUNDLES_DIR/ 下没有可清理的 bundle / sync.env =="
        exit 0
    fi
    if ! confirm "确认删除以上 $found 个文件? 输入 y 继续: "; then
        die "已取消"
    fi
    for f in "$BUNDLES_DIR"/bundle_*.tgz; do
        [ -e "$f" ] || continue
        rm -f -- "$f"
    done
    if [ -e "$BUNDLES_DIR/sync.env" ]; then
        rm -f -- "$BUNDLES_DIR/sync.env"
    fi
    printf '%s\n' "== 清理完成 =="
    exit 0
fi

# ---------- 清理模式：--clean（保留最新一份） ----------
if [ "$do_clean" -eq 1 ]; then
    newest=$(find_newest_bundle)
    if [ -z "$newest" ]; then
        die "$BUNDLES_DIR/ 下没有 bundle_*.tgz"
    fi
    printf '%s\n' "== --clean 将保留最新 bundle，删除其余 =="
    printf '  保留: %s/%s\n' "$BUNDLES_DIR" "$newest"
    found=0
    for f in "$BUNDLES_DIR"/bundle_*.tgz; do
        [ -e "$f" ] || continue
        if [ "${f##*/}" = "$newest" ]; then
            continue
        fi
        printf '  删除: %s\n' "$f"
        found=$((found + 1))
    done
    if [ "$found" -eq 0 ]; then
        printf '%s\n' "== 只有最新一份 bundle，无需清理 =="
        exit 0
    fi
    if ! confirm "确认删除以上 $found 个文件? 输入 y 继续: "; then
        die "已取消"
    fi
    for f in "$BUNDLES_DIR"/bundle_*.tgz; do
        [ -e "$f" ] || continue
        if [ "${f##*/}" = "$newest" ]; then
            continue
        fi
        rm -f -- "$f"
    done
    printf '%s\n' "== 清理完成 =="
    exit 0
fi

# ---------- 默认模式：校验最新 bundle 后解压替换 ./src ----------

# 1. 按文件名时间戳找最新 bundle
newest=$(find_newest_bundle)
if [ -z "$newest" ]; then
    die "$BUNDLES_DIR/ 下未找到 bundle_*.tgz（请先在本地项目根运行 publish-bundle 上传，或用 -h 查看用法）"
fi
archive="$BUNDLES_DIR/$newest"
total=0
for f in "$BUNDLES_DIR"/bundle_*.tgz; do
    [ -e "$f" ] || continue
    total=$((total + 1))
done

# 2. bundle.meta 完整性校验（文件名一致性 + SHA256）
command -v sha256sum >/dev/null 2>&1 || die "缺少 sha256sum 命令（coreutils）"
[ -f "$BUNDLES_DIR/$META_FILE" ] \
    || die "缺少 $BUNDLES_DIR/$META_FILE（请先在本地重新执行 publish-bundle 上传）"
meta_bundle=$(meta_get BUNDLE_FILE)
[ -n "$meta_bundle" ] || die "$META_FILE 缺少 BUNDLE_FILE 字段（文件不完整，请重新 publish）"
[ "$meta_bundle" = "$newest" ] || die "$META_FILE 记录的 BUNDLE_FILE($meta_bundle) 与最新 bundle($newest) 不一致——请重新 publish 或清理旧 bundle"
meta_sha=$(meta_get SHA256)
[ -n "$meta_sha" ] || die "$META_FILE 缺少 SHA256 字段（请重新 publish）"
meta_time=$(meta_get PUBLISHED_AT)
digest=$(sha256sum "$archive" | awk '{print $1}')
if [ "$digest" != "$meta_sha" ]; then
    die "SHA256 校验失败: bundle=$digest meta=$meta_sha（传输可能损坏或不完整，请重新 publish）"
fi

# 3. 展示将要发生什么，等待手动确认
src="$PWD/$SRC_DIR"
printf '%s\n' "== 执行 stage 将发生 =="
printf '  压缩包: %s（最新一份，目录下共 %d 份）\n' "$archive" "$total"
printf '  发布时间: %s\n' "${meta_time:-(meta 未记录)}"
printf '  SHA256: 校验通过（%s）\n' "$digest"
printf '  目标目录: %s\n' "$src"
printf '  前置钩子: make down 下线服务\n'
printf '  备份: 旧版本打包为 %s/backup_src_<时间戳>.tgz 后清空 %s/\n' "$BUNDLES_DIR" "$SRC_DIR"
printf '  解压新代码后不会自动运行任何代码，需要手动 make up 上线\n'
if ! confirm "确认执行 stage? 输入 y 继续: "; then
    die "已取消"
fi

# 4. 前置钩子: make down 下线服务（失败仅告警——服务可能本就未运行）
printf '%s\n' "== 前置钩子: make down（下线服务）=="
make_log=$(mktemp)
if make down >"$make_log" 2>&1; then
    printf '%s\n' "== 服务已下线 =="
else
    cat "$make_log" >&2
    printf '%s\n' "!! make down 未成功（服务可能本就未运行），继续 Stage"
fi
rm -f "$make_log"

# 5. 解压到临时目录（bundle 损坏在此暴露，尚未触碰 ./src）
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
trap 'exit 1' INT TERM

tar -xzf "$archive" -C "$tmp"

# publish-bundle 打包的是 src/ 的内容（无包裹目录）；历史整目录包仅有一个
# 顶层条目且为目录时进入该目录
top=$tmp
if [ "$(find "$tmp" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ]; then
    single=$(find "$tmp" -mindepth 1 -maxdepth 1)
    if [ -d "$single" ]; then
        top=$single
    fi
fi

# 6. 备份旧版本，再清空 ./src
ts=$(date +%m%d-%H%M%S)
backup="$BUNDLES_DIR/backup_src_$ts.tgz"
if [ -d "$src" ] && [ -n "$(ls -A "$src" 2>/dev/null)" ]; then
    mkdir -p "$BUNDLES_DIR"
    tar -czf "$backup" "$SRC_DIR"
    printf '  已备份旧版本: %s\n' "$backup"
    backup_for_hint=$backup
else
    printf '  %s/ 不存在或为空（首次部署），跳过备份\n' "$SRC_DIR"
    backup_for_hint=""
fi
mkdir -p "$src"
(
    cd "$src"
    for f in .[!.]* ..?* *; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        rm -rf -- "$f"
    done
)

# 7. 把新代码移入 ./src
(
    cd "$top"
    for f in .[!.]* ..?* *; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        mv -- "$f" "$src/"
    done
)

printf '%s\n' "== stage 完成: 新代码已就位 $src =="
if [ -n "$backup_for_hint" ]; then
    printf '  旧版本备份: %s（回滚: 在项目根执行 tar -xzf %s -C . 后手动 make up）\n' \
        "$backup_for_hint" "$backup_for_hint"
fi
printf '%s\n' "== 请手动执行 make up 上线服务 =="
